# Copiar como .env.test y completar con los datos de la base de pruebas.
# El nombre de la base debe terminar en _test: las pruebas borran sus datos.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_test"
NODE_ENV=test
JWT_SECRET=secreto-exclusivo-de-pruebas

# Administrador de pruebas: se crea (o se actualiza) al iniciar cada prueba.
# ADMIN_TEST_PASSWORD es la contraseña en texto plano, con al menos 8 caracteres.
ADMIN_TEST_EMAIL=admin_test@example.com
ADMIN_TEST_PASSWORD=ClaveAdminDePrueba2026!