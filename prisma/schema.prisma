// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ARTESANO
  ADMINISTRADOR
}

enum EstadoPostulacion {
  PENDIENTE           // Recién registrado
  EN_REVISION         // Siendo analizado por el admin
  REVISION_REQUERIDA  // El admin solicita modificaciones
  APROBADA            // Habilita al artesano a cargar productos/stands
  RECHAZADA           // Postulación declinada
}

enum EstadoStand {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
}

model Usuario {
  id_usuario      Int         @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String      @unique
  passwordHash    String
  rol             Rol         @default(ARTESANO)
  std_usuario     Boolean    @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  artesano                Artesano?
  postulaciones           Postulacion?  @relation("UsuarioPostula")
  postulacionesEvaluadas  Postulacion[] @relation("AdminEvalua")
}

model Rubro {
  id_rubro        Int         @id @default(autoincrement())
  nom_rubro       String
  desc_rubro      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  postulaciones   Postulacion[]
}

model Postulacion {
  id_postulacion  Int         @id @default(autoincrement())
  dni             String      @unique
  celular         String
  provincia       String            
  localidad       String            
  nom_emprend     String
  desc_emprend    String 
  trayectoria     String?
  std_postulacion EstadoPostulacion @default(PENDIENTE)
  observacion     String?

  usuarioId       Int         @unique
  usuario         Usuario     @relation("UsuarioPostula", fields: [usuarioId], references: [id_usuario], onDelete: Cascade)

  adminId         Int?        
  admin           Usuario?    @relation("AdminEvalua", fields: [adminId], references: [id_usuario], onDelete: SetNull)

  rubroId         Int         
  rubro           Rubro       @relation(fields: [rubroId], references: [id_rubro], onDelete: Restrict)

  artesano        Artesano?

  @@index([rubroId])
}

model Artesano {
  id_artesano     Int         @id @default(autoincrement())

  usuarioId       Int         @unique
  usuario         Usuario     @relation(fields: [usuarioId], references: [id_usuario], onDelete: Cascade)

  postulacionId   Int         @unique
  postulacion     Postulacion @relation(fields: [postulacionId], references: [id_postulacion], onDelete: Restrict)

  standId         Int?        @unique
  stand           Stand?      @relation(fields: [standId], references: [id_stand], onDelete: SetNull)

  productos       Producto[]
}

model Producto {
  id_producto     Int         @id @default(autoincrement())
  nom_producto    String
  desc_producto   String?
  precio          Decimal
  std_producto    Boolean     @default(true)

  artesanoId      Int         
  artesano        Artesano    @relation(fields: [artesanoId], references: [id_artesano], onDelete: Cascade)
}

model Pabellon {
  id_pabellon     Int         @id @default(autoincrement())
  nom_pabellon    String
  desc_pabellon   String?

  sectores        Sector[]
}

model Sector {
  id_sector       Int         @id @default(autoincrement())
  nom_sector      String

  pabellonId      Int         
  pabellon        Pabellon    @relation(fields: [pabellonId], references: [id_pabellon], onDelete: Cascade)

  stands          Stand[]
}

model Stand {
  id_stand        Int         @id @default(autoincrement())
  codigo          String      @unique
  latitud         Decimal?
  longitud        Decimal?
  std_stand       EstadoStand @default(MANTENIMIENTO)
  
  sectorId        Int
  sector          Sector      @relation(fields: [sectorId], references: [id_sector], onDelete: Cascade)
  
  artesano        Artesano?
}

model Consulta {
  id_consulta     Int         @id @default(autoincrement())
  metodo          String
  endpoint        String
  query           Json?
  params          Json?
  createAt        DateTime    @default(now())
}

model TokenRevocado {
  jti             String      @id
  venceEn         DateTime

  @@index([venceEn])

}