  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/artesanos/": {
      "get": {
        "tags": [
          "Artesanos"
        ],
        "summary": "Obtener todos los artesanos",
        "description": "Devuelve una lista de los artesanos registrados. Requiere token activo y rol de ADMINISTRADOR.",
        "responses": {
          "200": {
            "description": "Lista de artesanos obtenida exitosamente."
          },
          "400": {
            "description": "Parámetros de consulta inválidos."
          },
          "401": {
            "description": "Token ausente, inválido, vencido o revocado."
          },
          "403": {
            "description": "Acceso denegado. Se requiere rol de ADMINISTRADOR."
          }
        }
      }
    },
    "/artesanos/{id}": {
      "get": {
        "tags": [
          "Artesanos"
        ],
        "summary": "Obtener un artesano por ID",
        "description": "Busca y devuelve los detalles de un perfil de artesano. Requiere rol de ARTESANO o ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del artesano"
          }
        ],
        "responses": {
          "200": {
            "description": "Artesano encontrado."
          },
          "400": {
            "description": "ID inválido."
          },
          "401": {
            "description": "Token ausente, inválido, vencido o revocado."
          },
          "403": {
            "description": "Acceso denegado. Se requiere rol de ARTESANO o ADMINISTRADOR."
          },
          "404": {
            "description": "El artesano no existe."
          }
        }
      },
      "put": {
        "tags": [
          "Artesanos"
        ],
        "summary": "Actualizar datos del artesano",
        "description": "Permite modificar la información del perfil del artesano. Requiere rol de ARTESANO o ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del perfil de artesano a actualizar"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil de artesano actualizado exitosamente."
          },
          "400": {
            "description": "Cuerpo de la petición inválido."
          },
          "401": {
            "description": "Token ausente o inválido."
          },
          "403": {
            "description": "Acceso denegado."
          },
          "404": {
            "description": "El artesano no existe."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarArtesano"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Artesanos"
        ],
        "summary": "Eliminar un perfil de artesano",
        "description": "Elimina un artesano del sistema. Exclusivo para ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del artesano a eliminar"
          }
        ],
        "responses": {
          "200": {
            "description": "Artesano eliminado exitosamente."
          },
          "400": {
            "description": "ID inválido."
          },
          "401": {
            "description": "Token ausente o inválido."
          },
          "403": {
            "description": "Acceso denegado. Exclusivo para ADMINISTRADOR."
          },
          "404": {
            "description": "El artesano no existe."
          }
        }
      }
    },
    "/artesanos/{id}/stand": {
      "post": {
        "tags": [
          "Artesanos"
        ],
        "summary": "Asignar stand a un artesano",
        "description": "Permite asignar un stand específico a un artesano. Exclusivo para ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del artesano al que se le asignará el stand"
          }
        ],
        "responses": {
          "200": {
            "description": "Stand asignado exitosamente."
          },
          "400": {
            "description": "Datos de asignación inválidos."
          },
          "401": {
            "description": "Token ausente o inválido."
          },
          "403": {
            "description": "Acceso denegado. Exclusivo para ADMINISTRADOR."
          },
          "404": {
            "description": "El artesano no existe."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignacionStand"
              }
            }
          }
        }
      }
    },
    "/productos/": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Obtener todos los productos",
        "description": "Devuelve una lista de todos los productos. Soporta autenticación opcional.",
        "responses": {
          "200": {
            "description": "Lista de productos obtenida exitosamente."
          },
          "400": {
            "description": "Parámetros de consulta inválidos."
          }
        }
      },
      "post": {
        "tags": [
          "Productos"
        ],
        "summary": "Cargar un nuevo producto",
        "description": "Requiere token JWT activo y rol de ARTESANO o ADMINISTRADOR.",
        "responses": {
          "201": {
            "description": "Producto creado exitosamente."
          },
          "400": {
            "description": "Cuerpo inválido. Faltan datos o no cumplen el formato (Validación Zod)."
          },
          "401": {
            "description": "Token ausente, inválido, vencido o revocado."
          },
          "403": {
            "description": "Cuenta inactiva o no tiene rol de ARTESANO / ADMINISTRADOR."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevoProducto"
              }
            }
          }
        }
      }
    },
    "/productos/{id}": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Obtener un producto por ID",
        "description": "Busca y devuelve los detalles de un producto específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del producto"
          }
        ],
        "responses": {
          "200": {
            "description": "Producto encontrado."
          },
          "400": {
            "description": "ID inválido."
          },
          "404": {
            "description": "El producto no existe."
          }
        }
      },
      "put": {
        "tags": [
          "Productos"
        ],
        "summary": "Actualizar un producto existente",
        "description": "Permite modificar los datos de un producto. Requiere token JWT y rol de ARTESANO o ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del producto a actualizar"
          }
        ],
        "responses": {
          "200": {
            "description": "Producto actualizado exitosamente."
          },
          "400": {
            "description": "ID o cuerpo inválido."
          },
          "401": {
            "description": "Token ausente, inválido, vencido o revocado."
          },
          "403": {
            "description": "Cuenta inactiva o sin permisos suficientes."
          },
          "404": {
            "description": "El producto no existe."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevoProducto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Productos"
        ],
        "summary": "Eliminar un producto",
        "description": "Borra un producto de la base de datos. Requiere token JWT y rol de ARTESANO o ADMINISTRADOR.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del producto a eliminar"
          }
        ],
        "responses": {
          "200": {
            "description": "Producto eliminado exitosamente."
          },
          "400": {
            "description": "ID inválido."
          },
          "401": {
            "description": "Token ausente, inválido, vencido o revocado."
          },
          "403": {
            "description": "Cuenta inactiva o sin permisos suficientes."
          },
          "404": {
            "description": "El producto no existe."
          }
        }
      }
    },
